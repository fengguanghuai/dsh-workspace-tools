{
  "name": "@fengguanghuai/dsh-workspace-tools",
  "version": "0.2.0",
  "description": "DeepSeek Harness workspace & sidebar suite: global pinned sessions/workspaces, header quick actions, 7-color labels, recency sort, auto-fold old history, and agent tools.",
  "license": "MIT",
  "author": "fengguanghuai",
  "homepage": "https://github.com/fengguanghuai/dsh-workspace-tools#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fengguanghuai/dsh-workspace-tools.git"
  },
  "bugs": {
    "url": "https://github.com/fengguanghuai/dsh-workspace-tools/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "dsh": ">=0.2.0"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "workspace",
    "session-title",
    "agent-tools"
  ],
  "type": "module",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/icon-180.png",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-context-menu",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  }
}
