  "description": "DeepSeek Harness agent tools for managing sidebar workspaces and session titles directly through chat.",
  "license": "MIT",
  "author": "fengguanghuai",
  "homepage": "https://github.com/fengguanghuai/dsh-workspace-tools#readme",
  "repository": {
